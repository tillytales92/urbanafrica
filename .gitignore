# ---- Data (large, reproducible from source downloads — see CLAUDE.md) --------
/data/

# ---- Generated outputs -----------------------------------------------------
# /output/* (not /output/) so the negation below can still reach into the dir --
# git can't re-include a path whose parent directory itself is excluded.
/output/*
# ...except hand-written report sources (the .qmd is source; its rendered
# .html/_files are generated and stay ignored by the rule above).
!/output/*.qmd
# ...and the hand-written scrollytelling HTML (urban_growth_story.html is
# source like the .qmd, not a render; its *_data.json is a generated export
# from export_bubble_story_data.R and stays ignored).
!/output/urban_growth_story.html
Rplots.pdf
Rplot.jpeg

# ---- App: deploy bundle ---------------------------------------------------
# Keep the small summary .Rds tracked (they let the app run without the 100 GB
# pipeline); never track the per-city raster tree behind this symlink.
/app/data/cities

# Posit Connect deploy metadata (ties the repo to one account/target).
/app/rsconnect/

# ---- R / RStudio ---------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*_cache/
*.utf8.md
*.knit.md

# ---- Claude Code -------------------------------------------------------
.claude/settings.local.json

# ---- Local secrets / machine config ----------------------------------
.Renviron
.env

# ---- OS / editor ----------------------------------------------------
.DS_Store
Thumbs.db
*~
